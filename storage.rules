rules_version = '2';

// Firebase Storage access rules.
//
// Pose artwork (/poses/*) is public-readable because every mobile client
// — including fresh/anonymous installs — needs to render it without any
// auth hop. Only admin custom-claim holders can upload / overwrite art.
// Max 5 MB per upload; limits are enforced server-side so a leaked SDK
// key can't DOS the bucket with huge files.
service firebase.storage {
  match /b/{bucket}/o {

    match /poses/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true
        && (
          request.resource == null
          || (
            request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')
          )
        );
    }

    // Default deny for everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
