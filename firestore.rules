rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Public content (managed via admin panel) --------
    // Read: herkes okuyabilir (mobil uygulama anonim de okur)
    // Write: sadece admin custom claim taşıyan kullanıcılar

    match /categories/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /placeCategories/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /diceFaces/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    // Art decks (Pozlar + Göz Ucuyla) — görseller Storage'da, doc'ta URL
    match /poses/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /glimpses/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    match /meta/{doc} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // -------- User submissions (öneriler + fanteziler) --------
    // Signed-in users (anonymous auth) can CREATE but never read or
    // modify others' submissions. Admin panel is the only reader.
    // The uid on the doc must match the caller so we can later show
    // "my submissions" or rate-limit per user.

    match /suggestions/{doc} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 4
        && request.resource.data.text.size() <= 1000;
      allow read, update, delete:
        if request.auth != null && request.auth.token.admin == true;
    }

    match /fantasies/{doc} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 4
        && request.resource.data.text.size() <= 1000;
      allow read, update, delete:
        if request.auth != null && request.auth.token.admin == true;
    }

    // -------- Safety reports (App Store §1.2) --------
    // Anyone signed in can file a report about a note / partner; only the
    // admin panel can read or triage them.

    match /reports/{doc} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.reason in ['harassment', 'inappropriate', 'spam', 'other']
        && request.resource.data.roomCode is string
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 500
        && request.resource.data.noteText is string
        && request.resource.data.noteText.size() <= 1000
        && request.resource.data.status == 'new';
      allow read, update, delete:
        if request.auth != null && request.auth.token.admin == true;
    }

    // -------- Rooms & Boxes (Kutular real-time) --------

    match /rooms/{roomCode} {
      // Odayı sadece host veya guest okuyabilir.
      // İstisnalar:
      //   1) doc hiç yoksa (resource == null) — createRoom'un çakışma
      //      kontrolü ve joinRoom'un "kod geçerli mi" kontrolü gerekli.
      //   2) guestUid == null — joinRoom transaction'ı önce tx.get() yapıp
      //      slot boş mu bakar; henüz guest olmayan kullanıcı bu adımı
      //      geçemezse katılamıyor.
      // İkisinde de içerik sızıntısı minimal: sadece "kod boşta mı /
      // kullanımda mı / slot açık mı" bilgisi.
      allow read: if request.auth != null && (
        resource == null ||
        resource.data.guestUid == null ||
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid == resource.data.guestUid
      );

      // Oda oluşturma: kendini host olarak yazmalı, guest null olmalı
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.hostUid
        && request.resource.data.guestUid == null;

      // Güncelleme:
      // 1) Host → serbest; ama hostUid'i ancak mevcut guest'e devredebilir
      //    (odadan ayrılırken). Partneri çıkarıp engellemek de burada.
      // 2) Guest → sadece ortak track/level ve kendi slotunu boşaltma
      //    (ayrılma). hostUid / blockedUids'e dokunamaz.
      // 3) Boş oda (guestUid=null) → sadece guestUid=self (join); host'un
      //    engellediği uid katılamaz.
      allow update: if request.auth != null && (
        (
          request.auth.uid == resource.data.hostUid &&
          (
            request.resource.data.hostUid == resource.data.hostUid ||
            (resource.data.guestUid != null &&
              request.resource.data.hostUid == resource.data.guestUid)
          )
        ) ||
        (
          request.auth.uid == resource.data.guestUid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['track', 'level', 'guestUid']) &&
          (request.resource.data.guestUid == resource.data.guestUid ||
            request.resource.data.guestUid == null)
        ) ||
        (
          resource.data.guestUid == null &&
          request.resource.data.guestUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['guestUid']) &&
          !(request.auth.uid in resource.data.get('blockedUids', []))
        )
      );

      // Oda silme sadece host
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.hostUid;

      // Moderasyon: admin panel şikâyet edilen kişiyi çıkarıp engelleyebilir
      // (guestUid / hostUid / blockedUids) — silemez.
      allow read, update: if request.auth != null && request.auth.token.admin == true;

      // Kutular: sadece odanın host'u veya guest'i CRUD yapabilir
      match /boxes/{boxId} {
        // Moderasyon: admin şikâyet edilen notları silebilir.
        allow read, update: if request.auth != null && request.auth.token.admin == true;
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid ||
          get(/databases/$(database)/documents/rooms/$(roomCode)).data.guestUid == request.auth.uid
        );
      }
    }
  }
}
